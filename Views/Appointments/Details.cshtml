@model ClinicAppointmentManagement.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container mt-4">

    <h2>Appointment Details</h2>

    <div class="card">

        <div class="card-body">

            <p>
                <strong>Doctor:</strong>
                @Model.Doctor?.Name
            </p>

            <p>
                <strong>Specialization:</strong>
                @Model.Doctor?.Specialization
            </p>

            <p>
                <strong>Patient:</strong>
                @Model.Patient?.Name
            </p>

            <p>
                <strong>Patient Phone:</strong>
                @Model.Patient?.Phone
            </p>

            <p>
                <strong>Date:</strong>
                @Model.AppointmentDate.ToString("dd-MM-yyyy")
            </p>

            <p>
                <strong>Time:</strong>
               @DateTime.Today.Add(@Model.AppointmentTime).ToString("hh:mm tt")
            </p>

            <p>
                <strong>Reason:</strong>
                @Model.Reason
            </p>

        </div>

    </div>

    <br />

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>