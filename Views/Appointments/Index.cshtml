@model IEnumerable<ClinicAppointmentManagement.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<div class="w-full">

    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">

        <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-800">
                Appointments
            </h2>

            <p class="text-sm text-gray-500 mt-1">
                Manage and search patient appointments
            </p>
        </div>

        <a asp-action="Create"
           class="inline-flex items-center justify-center px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition no-underline w-full sm:w-auto">

            + Book Appointment

        </a>

    </div>


    <!-- Search / Filter Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 sm:p-5 mb-5">

        <form method="get"
              asp-action="Index"
              class="grid grid-cols-1 md:grid-cols-12 gap-3">

            <!-- Search -->
            <div class="md:col-span-5">

                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Search
                </label>

                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                       placeholder="Search doctor or patient" />

            </div>


            <!-- Date -->
            <div class="md:col-span-4">

                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Appointment Date
                </label>

                <input type="date"
                       name="date"
                       value="@ViewBag.Date"
                       class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />

            </div>


            <!-- Buttons -->
            <div class="md:col-span-3 flex flex-col sm:flex-row md:items-end gap-2">

                <button type="submit"
                        class="w-full sm:w-auto flex-1 px-4 py-2.5 bg-gray-800 hover:bg-gray-900 text-white font-medium rounded-lg transition">

                    Search

                </button>

                <a asp-action="Index"
                   class="w-full sm:w-auto flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-gray-500 hover:bg-gray-600 text-white font-medium rounded-lg transition no-underline">

                    Clear

                </a>

            </div>

        </form>

    </div>


    <!-- Appointments Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">

        <!-- Horizontal scrolling on mobile -->
        <div class="overflow-x-auto">

            <table class="w-full min-w-[900px] text-sm text-left">

                <thead class="bg-gray-50 border-b border-gray-200">

                    <tr>

                        <th class="px-4 sm:px-6 py-3.5 font-semibold text-gray-700 whitespace-nowrap">
                            Doctor
                        </th>

                        <th class="px-4 sm:px-6 py-3.5 font-semibold text-gray-700 whitespace-nowrap">
                            Patient
                        </th>

                        <th class="px-4 sm:px-6 py-3.5 font-semibold text-gray-700 whitespace-nowrap">
                            Date
                        </th>

                        <th class="px-4 sm:px-6 py-3.5 font-semibold text-gray-700 whitespace-nowrap">
                            Time
                        </th>

                        <th class="px-4 sm:px-6 py-3.5 font-semibold text-gray-700 whitespace-nowrap">
                            Reason
                        </th>

                        <th class="px-4 sm:px-6 py-3.5 font-semibold text-gray-700 whitespace-nowrap">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody class="divide-y divide-gray-200">

                    @if (Model != null && Model.Any())
                    {
                        foreach (var appointment in Model)
                        {
                            <tr class="hover:bg-gray-50 transition">

                                <td class="px-4 sm:px-6 py-4 font-medium text-gray-800 whitespace-nowrap">
                                    @appointment.Doctor?.Name
                                </td>

                                <td class="px-4 sm:px-6 py-4 text-gray-600 whitespace-nowrap">
                                    @appointment.Patient?.Name
                                </td>

                                <td class="px-4 sm:px-6 py-4 text-gray-600 whitespace-nowrap">
                                    @appointment.AppointmentDate.ToString("dd-MM-yyyy")
                                </td>

                               <td class="px-4 sm:px-6 py-4 text-gray-600 whitespace-nowrap">
                                    @DateTime.Today.Add(appointment.AppointmentTime).ToString("hh:mm tt")
                                </td>

                                <td class="px-4 sm:px-6 py-4 text-gray-600 max-w-xs">
                                    <span class="block truncate">
                                        @appointment.Reason
                                    </span>
                                </td>

                                <td class="px-4 sm:px-6 py-4">

                                    <a asp-action="Details"
                                       asp-route-id="@appointment.AppointmentId"
                                       class="inline-flex items-center justify-center px-3 py-1.5 bg-cyan-500 hover:bg-cyan-600 text-white text-sm font-medium rounded-md transition no-underline">

                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="px-4 py-10 text-center">

                                <div class="text-gray-500">

                                    <p class="text-base font-medium">
                                        No appointments found.
                                    </p>

                                    <p class="text-sm mt-1">
                                        Try changing your search or date filter.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>