@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="display-5 fw-bold">
            Clinic Appointment Management
        </h1>

        <p class="text-muted">
            Manage doctors, patients, and appointments from one place.
        </p>
    </div>

    <!-- Navigation Cards -->
    <div class="row g-4">

        <!-- Doctors -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="card-title">
                        Doctors
                    </h4>

                    <p class="card-text text-muted">
                        Add, edit and view doctors and
                        their specializations.
                    </p>

                    <a asp-controller="Doctors"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Doctors
                    </a>

                </div>

            </div>

        </div>


        <!-- Patients -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="card-title">
                        Patients
                    </h4>

                    <p class="card-text text-muted">
                        Add, edit and view patient information.
                    </p>

                    <a asp-controller="Patients"
                       asp-action="Index"
                       class="btn btn-success">
                        Manage Patients
                    </a>

                </div>

            </div>

        </div>


        <!-- Appointments -->
        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h4 class="card-title">
                        Appointments
                    </h4>

                    <p class="card-text text-muted">
                        Book appointments and search
                        existing appointments.
                    </p>

                    <a asp-controller="Appointments"
                       asp-action="Index"
                       class="btn btn-info">
                        View Appointments
                    </a>

                </div>

            </div>

        </div>

    </div>


    

</div>